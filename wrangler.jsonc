{
  // Static Eating on 30A guide. Worker name is eatingon30a.
  // Preview only: do not add a custom domain binding in this file.
  // The preview URL is the workers.dev hostname Cloudflare assigns this Worker.
  // Signup and listing mail is sent only when RESEND_API_KEY, SUBSCRIBE_FROM, and CONTACT_EMAIL are set.
  // Coupon signups are also appended when GOOGLE_SHEETS_WEBHOOK_URL and GOOGLE_SHEETS_WEBHOOK_TOKEN are set.
  // Account sign-in can append a Destin coupon row when GOOGLE_SHEETS_WEBHOOK_TOKEN_DESTIN is also set.
  // A missing Destin token skips that row and does not block the magic link.
  // Signed-in My places opt-in uses those same tokens and does not send the coupon email.
  // Missing Sheets secrets skip the webhook (recorded: false) and do not change the Resend delivered flag.
  // recorded is true only when the webhook body is JSON with ok: true. HTTP 200 alone is not enough.
  "name": "eatingon30a",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  // Shared accounts live on the eating-accounts Worker. Change ACCOUNTS_ORIGIN
  // if that workers.dev hostname differs. The matching secret is
  // ACCOUNTS_SHARED_SECRET, set with wrangler secret put, not in this file.
  "vars": {
    "ACCOUNT_SITE": "30a",
    "ACCOUNTS_ORIGIN": "https://eating-accounts.352marc.workers.dev"
  },
  // wrangler preview will not inherit production vars. These are the same
  // workers.dev account settings already used above.
  "previews": {
    "vars": {
      "ACCOUNT_SITE": "30a",
      "ACCOUNTS_ORIGIN": "https://eating-accounts.352marc.workers.dev"
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
