{
  // Shared accounts for Eating on 30A and Eating in Destin.
  // Do not attach a custom domain in this file. The public hostname is the
  // workers.dev host Cloudflare assigns, unless Marc changes ACCOUNTS_ORIGIN
  // on the two site Workers after he adds a hostname in the dashboard.
  //
  // Hand deploy from this directory: npx wrangler deploy
  // database_id is the live eating-accounts D1 database. Do not replace it,
  // and do not create a second database for a code deploy.
  // Do not set MAGIC_LINK_PREVIEW in production. It returns the sign-in link
  // in the API response for local testing only.
  "name": "eating-accounts",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eating-accounts",
      "database_id": "f3ae29af-a929-4185-b5bd-b349cc015a3f",
      "migrations_dir": "migrations"
    }
  ],
  // Listing photos uploaded in the admin. Create the bucket once before deploy:
  //   npx wrangler r2 bucket create eating-listings
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "eating-listings"
    }
  ]
}
